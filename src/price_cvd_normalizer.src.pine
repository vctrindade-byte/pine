const string TT_COL     = "Cores das linhas: preço e CVD. Com o cinzento por omissão, a linha do preço usa a cor do " +
     "texto do tema (branca no escuro, preta no claro), para se distinguir dos elementos neutros."
const string TT_AHEAD   = "Preenchimento e colunas Z. Z > 0: nas últimas K barras o preço subiu mais (ou caiu menos) " +
     "do que o fluxo implica — preço à frente do fluxo (não é um sinal de alta: inclui vendas sem queda do preço e " +
     "subidas sem compras). Z < 0: fluxo à frente do preço."
const string TT_RES     = "Cores das resoluções e dos eventos: subida, descida e neutro."
const string TT_WIDTH   = "Espessura das linhas do preço e do CVD."
const string TT_TBL     = "Tabela de estado: fonte e qualidade, Z e estado, último evento (e, na versão completa, " +
     "cobertura, ρ, λ, NAR e tipo de volume)."
const string TT_TBLMODE = "Compacta: uma coluna com 3 linhas (fonte, qualidade e avisos; Z e estado; último evento); " +
     "a âncora, o NAR e os pormenores ficam nas dicas das células. Completa: 9 linhas — precisa de um painel mais alto."
